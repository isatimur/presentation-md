{
  "name": "@presentation-md/mcp-server",
  "version": "1.14.2",
  "description": "MCP server exposing all 11 presentation-md tools (render/export/audit/judge/import/preview) to any MCP-compatible AI agent.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "presentation-md-mcp": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@presentation-md/core": "workspace:*",
    "@presentation-md/create-theme": "workspace:*",
    "@presentation-md/export": "workspace:^",
    "@presentation-md/render": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isatimur/presentation-md.git"
  },
  "homepage": "https://presentation-md.vercel.app",
  "bugs": "https://github.com/isatimur/presentation-md/issues"
}
