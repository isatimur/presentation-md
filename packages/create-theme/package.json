{
  "name": "@presentation-md/create-theme",
  "version": "1.0.16",
  "description": "Scaffold a new presentation-md theme package.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "create-presentation-md-theme": "./dist/index.js"
  },
  "files": [
    "dist",
    "src/template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R src/template dist/template",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@presentation-md/core": "workspace:*",
    "commander": "^12.0.0",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.0.0",
    "playwright": "^1.46.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isatimur/presentation-md.git"
  },
  "homepage": "https://presentation-md.vercel.app",
  "bugs": "https://github.com/isatimur/presentation-md/issues"
}
