{
  "name": "@presentation-md/install",
  "version": "1.1.21",
  "description": "One-command installer for presentation-md adapters.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "presentation-md-install": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/adapters dist/skills/deck-design-judge && cp -R ../../adapters/. dist/adapters/ && cp -R ../../skills/deck-design-judge/. dist/skills/deck-design-judge/",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@presentation-md/core": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isatimur/presentation-md.git"
  },
  "homepage": "https://presentation-md.vercel.app",
  "bugs": "https://github.com/isatimur/presentation-md/issues"
}
