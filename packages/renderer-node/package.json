{
  "name": "@presentation-md/render",
  "version": "1.6.17",
  "description": "Render a deck JSON spec to a self-contained HTML slide deck.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "shared"
  ],
  "bin": {
    "presentation-md-render": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../tools/sync-render-shared.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@presentation-md/core": "workspace:*",
    "@presentation-md/export": "workspace:*",
    "commander": "^12.0.0",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isatimur/presentation-md.git"
  },
  "homepage": "https://presentation-md.vercel.app",
  "bugs": "https://github.com/isatimur/presentation-md/issues"
}
