{
  "name": "@presentation-md/core",
  "version": "1.34.0",
  "description": "presentation-md core — Deck JSON schemas, 75-theme loader, craft audit, and the presentation-generator skill for AI agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./theme-types": "./dist/theme-types.js",
    "./chart-svg": "./dist/chart-svg.js",
    "./sanitize-html": "./dist/sanitize-html.js",
    "./candy-marquee": "./dist/candy-marquee.js",
    "./craft-audit": "./dist/craft-audit.js",
    "./validate-deck": "./dist/validate-deck.js",
    "./theme-surface": "./dist/theme-surface.js",
    "./theme-loader": "./dist/theme-loader.js",
    "./theme-browse": "./dist/theme-browse.js",
    "./skill": "./SKILL.md",
    "./deck-schema": "./deck.schema.json",
    "./theme-schema": "./theme.schema.json",
    "./themes/default-tech": "./themes/default-tech/theme.json",
    "./themes/claude": "./themes/claude/theme.json"
  },
  "files": [
    "dist",
    "SKILL.md",
    "references",
    "scripts",
    "deck.schema.json",
    "theme.schema.json",
    "themes/default-tech",
    "themes/claude"
  ],
  "bin": {
    "validate-theme": "./dist/validate-theme-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isatimur/presentation-md.git"
  },
  "homepage": "https://presentation-md.vercel.app",
  "bugs": "https://github.com/isatimur/presentation-md/issues"
}
