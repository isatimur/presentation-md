{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-md.vercel.app/deck.schema.json",
  "title": "presentation-md Deck",
  "type": "object",
  "required": ["type", "slides"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "deck" },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "description": { "type": "string" },
        "theme": { "type": "string", "description": "Theme name (default: default-tech)" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "required": ["layout"],
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "title",
            "two-column",
            "feature-grid",
            "quote",
            "data-table",
            "stat-row",
            "timeline",
            "section",
            "closing",
            "image-hero",
            "comparison",
            "code",
            "chart",
            "custom-html",
            "ranked-list",
            "logo-wall"
          ]
        },
        "variant": {
          "type": "string",
          "enum": ["default", "hero"],
          "description": "stat-row: \"hero\" = mega-number wrap beat (first stat dominates)."
        },
        "items": {
          "type": "array",
          "description": "ranked-list: ordered bars with optional rank / value / widthPct.",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "rank": { "type": "string", "description": "Display rank (default 01, 02, …)." },
              "label": { "type": "string" },
              "value": { "type": "string", "description": "Optional secondary metric on the bar." },
              "widthPct": {
                "type": "number",
                "minimum": 1,
                "maximum": 100,
                "description": "Bar fill width percent (default auto from order)."
              }
            }
          }
        },
        "chartType": {
          "type": "string",
          "enum": ["bar", "horizontal-bar", "line", "area", "pie", "donut"],
          "description": "chart: visualization type (default bar)."
        },
        "categories": {
          "type": "array",
          "items": { "type": "string" },
          "description": "chart: category / x-axis labels (also pie slice labels)."
        },
        "series": {
          "type": "array",
          "description": "chart: one or more named numeric series.",
          "items": {
            "type": "object",
            "required": ["values"],
            "properties": {
              "name": { "type": "string" },
              "values": {
                "type": "array",
                "items": { "type": "number" }
              }
            }
          }
        },
        "showLegend": {
          "type": "boolean",
          "description": "chart: show series/slice legend (default true)."
        },
        "showValues": {
          "type": "boolean",
          "description": "chart: annotate data values on marks (default false)."
        },
        "stacked": {
          "type": "boolean",
          "description": "chart: stack bar series (bar / horizontal-bar only)."
        },
        "html": {
          "type": "string",
          "description": "custom-html: sanitized HTML fragment for one-off art (no scripts)."
        },
        "tone": {
          "type": "string",
          "enum": ["default", "lime", "magenta", "cyan", "orange", "violet"],
          "description": "Optional per-slide hue beat (kinetic-wrapped / Pulse multi-hue craft)."
        },
        "eyebrow": { "type": "string" },
        "heading": { "type": "string" },
        "lead": { "type": "string" },
        "body": { "type": "string" },
        "aside": {
          "type": "string",
          "description": "two-column: pull-quote / callout panel when no image is set."
        },
        "ratio": {
          "type": "string",
          "enum": ["1-1", "2-1", "1-2", "3-2", "2-3"],
          "description": "two-column: asymmetric column flex ratio (default balanced)."
        },
        "reverse": {
          "type": "boolean",
          "description": "two-column: put media/aside on the left."
        },
        "image": { "type": "string" },
        "imageAlt": { "type": "string" },
        "quote": { "type": "string" },
        "by": { "type": "string" },
        "number": { "type": "string" },
        "code": {
          "type": "string",
          "description": "code layout: source snippet (plain text; HTML-escaped on render)."
        },
        "language": {
          "type": "string",
          "description": "code layout: language label shown in the window chrome."
        },
        "filename": {
          "type": "string",
          "description": "code layout: optional file name in the window chrome (overrides language label)."
        },
        "emphasis": {
          "type": "string",
          "enum": ["left", "right"],
          "description": "comparison: grow the emphasized column."
        },
        "columns": {
          "oneOf": [
            { "type": "integer", "minimum": 2, "maximum": 4 },
            { "type": "string", "enum": ["bento"], "description": "feature-grid: asymmetric 5-up bento (hero + 4)." },
            { "type": "array", "items": { "type": "string" } }
          ],
          "description": "feature-grid: column count (2-4) or \"bento\". data-table: header labels."
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "icon": { "type": "string", "description": "FontAwesome class, e.g. fa-solid fa-bolt" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "image": { "type": "string", "description": "logo-wall / cards: image URL or data URI" },
              "imageAlt": { "type": "string" }
            }
          }
        },
        "rows": {
          "type": "array",
          "description": "data-table: array of row arrays.",
          "items": { "type": "array", "items": { "type": "string" } }
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        },
        "orientation": {
          "type": "string",
          "enum": ["horizontal", "vertical"],
          "description": "timeline: rail direction (default horizontal, matches HTML)."
        },
        "cta": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "href": { "type": "string" }
          }
        },
        "leftLabel": { "type": "string", "description": "comparison: label for the left column." },
        "rightLabel": { "type": "string", "description": "comparison: label for the right column." },
        "left": { "type": "string", "description": "comparison: body copy for the left column." },
        "right": { "type": "string", "description": "comparison: body copy for the right column." },
        "notes": {
          "type": "string",
          "description": "Speaker notes — round-trip via PPTX import/export; not rendered on the HTML slide."
        }
      }
    }
  }
}
