    {
      "layout": "code",
      "eyebrow": "The code that matters",
      "heading": "Decoding on arrival took twelve lines and one bounded queue",
      "filename": "station/stream.py",
      "language": "python",
      "code": "async def forward(radio, bus):\n    q = asyncio.Queue(maxsize=256)  # bounded: drop, never block\n    async for frame in radio.frames():\n        try:\n            q.put_nowait(frame)\n        except asyncio.QueueFull:\n            metrics.dropped.inc()\n            continue\n        pkt = decode(await q.get())   # per frame, ~4 ms\n        await bus.publish(\"tlm.ap3\", pkt)\n        metrics.hop_ms.observe(pkt.age_ms())\n"
    },
